-- Pls Donate Logic
local function GetBoothSign()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "BoothSign" and v:FindFirstChild("SurfaceGui") then
            local sg = v.SurfaceGui
            if sg:FindFirstChild("Frame") and sg.Frame:FindFirstChild("TextLabel") then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (v.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if dist < 20 then
                        return v
                    end
                end
            end
        end
    end
    return nil
end

local function SetBoothText(text)
    local sign = GetBoothSign()
    if sign and sign.SurfaceGui and sign.SurfaceGui:FindFirstChild("Frame") and sign.SurfaceGui.Frame:FindFirstChild("TextLabel") then
        sign.SurfaceGui.Frame.TextLabel.Text = text
        local remote = ReplicatedStorage:FindFirstChild("BoothText")
        if remote then
            remote:FireServer(text)
        end
    end
end

RunService.RenderStepped:Connect(function()
    if State.antiAfk then
        pcall(function()
            LocalPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
    end

    if State.espEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    if not ESP_drawings[plr] then ESP_drawings[plr] = {} end
                    local drawings = ESP_drawings[plr]
                    
                    if State.espBoxes then
                        if not drawings.Box then 
                            drawings.Box = Drawing.new("Square")
                            drawings.Box.Thickness = 1
                            drawings.Box.Filled = false
                        end
                        local headPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        drawings.Box.Size = Vector2.new(math.abs(headPos.X - legPos.X) / 2, math.abs(headPos.y - legPos.Y))
                        drawings.Box.Position = Vector2.new(pos.X - drawings.Box.Size.X / 2, pos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = Color3.fromRGB(255, 0, 255)
                        drawings.Box.Visible = true
                    elseif drawings.Box then drawings.Box.Visible = false end

                    if State.espTracers then
                        if not drawings.Tracer then
                            drawings.Tracer = Drawing.new("Line")
                            drawings.Tracer.Thickness = 1
                        end
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(pos.X, pos.Y)
                        drawings.Tracer.Color = Color3.fromRGB(0, 255, 0)
                        drawings.Tracer.Visible = true
                    elseif drawings.Tracer then drawings.Tracer.Visible = false end

                    if State.espNametags then
                        if not drawings.Name then
                            drawings.Name = Drawing.new("Text")
                            drawings.Name.Size = 13
                            drawings.Name.Center = true
                            drawings.Name.Outline = true
                        end
                        drawings.Name.Text = plr.Name
                        drawings.Name.Position = Vector2.new(pos.X, pos.Y - 30)
                        drawings.Name.Color = Color3.fromRGB(255, 255, 0)
                        drawings.Name.Visible = true
                    elseif drawings.Name then drawings.Name.Visible = false end
                else
                    if ESP_drawings[plr] then
                        for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                    end
                end
            else
                if ESP_drawings[plr] then
                    for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                end
            end
        end
    end
end)

