local tooltipThread = nil
local function SetupTooltip(guiObj, text)
    if not guiObj or not text or text == "" then return end
    
    guiObj.MouseEnter:Connect(function()
        tooltipThread = task.spawn(function()
            task.wait(1.5)
            if guiObj and guiObj.Parent then
                TooltipLabel.Text = text
                TooltipFrame.Size = UDim2.new(0, 250, 0, 30 + math.ceil(string.len(text) / 35) * 15)
                TooltipFrame.Visible = true
                TweenService:Create(TooltipFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
            end
        end)
    end)
    
    guiObj.MouseLeave:Connect(function()
        if tooltipThread then task.cancel(tooltipThread) end
        TooltipFrame.Visible = false
    end)
end

