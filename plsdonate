                SetBoothText(State.spamMessage)
            end)
        end
    end
end)

task.spawn(function()
    local hue = 0
    local bouncePos = 0
    local bounceDir = 1
    while task.wait(0.1) do
        if State.textRainbow or State.textGlow or State.textBounce then
            pcall(function()
                local sign = GetBoothSign()
                if sign and sign.SurfaceGui and sign.SurfaceGui:FindFirstChild("Frame") and sign.SurfaceGui.Frame:FindFirstChild("TextLabel") then
                    local txt = sign.SurfaceGui.Frame.TextLabel
                    if State.textRainbow then
                        hue = hue + 0.05
                        if hue > 1 then hue = 0 end
                        txt.TextColor3 = Color3.fromHSV(hue, 1, 1)
                    end
                    if State.textGlow then
                        txt.Font = Enum.Font.GothamBold
                        txt.TextStrokeTransparency = 0
                        txt.TextStrokeColor3 = Color3.fromRGB(255, 0, 255)
                    else
                        txt.TextStrokeTransparency = 1
                    end
                    if State.textBounce then
                        bouncePos = bouncePos + bounceDir
                        if bouncePos > 5 then bounceDir = -1 end
                        if bouncePos < -5 then bounceDir = 1 end
                        txt.Rotation = bouncePos
                    else
                        txt.Rotation = 0
                        txt.TextSize = 40
                    end
                end
            end)
        end
    end
end)

