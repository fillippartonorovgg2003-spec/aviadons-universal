-- MM2 Logic
local function GetRole(plr)
    if not plr then return "Innocent" end
    if plr.Backpack:FindFirstChild("Knife") or (plr.Character and plr.Character:FindFirstChild("Knife")) then return "Murderer" end
    if plr.Backpack:FindFirstChild("Gun") or (plr.Character and plr.Character:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0) end
    if role == "Sheriff" then return Color3.fromRGB(0, 0, 255) end
    return Color3.fromRGB(0, 255, 0)
end

RunService.RenderStepped:Connect(function()
    if State.espEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local role = GetRole(plr)
                local color = GetRoleColor(role)
                
                if State.espChams then
                    if not HighlightObjects[plr] or not HighlightObjects[plr].Parent then
                        local hl = Instance.new("Highlight")
                        hl.Parent = plr.Character
                        HighlightObjects[plr] = hl
                    end
                    HighlightObjects[plr].FillColor = color
                    HighlightObjects[plr].OutlineColor = Color3.fromRGB(255, 255, 255)
                    HighlightObjects[plr].FillTransparency = 0.5
                    HighlightObjects[plr].OutlineTransparency = 0
                    HighlightObjects[plr].Enabled = true
                else
                    if HighlightObjects[plr] then HighlightObjects[plr].Enabled = false end
                end
                
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    if not ESP_drawings[plr] then ESP_drawings[plr] = {} end
                    local drawings = ESP_drawings[plr]
                    
                    if State.espBoxes then
                        if not drawings.Box then 
                            drawings.Box = Drawing.new("Square")
                            drawings.Box.Thickness = 1
                            drawings.Box.Filled = false
                        end
                        local headPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        drawings.Box.Size = Vector2.new(math.abs(headPos.X - legPos.X) / 2, math.abs(headPos.Y - legPos.Y))
                        drawings.Box.Position = Vector2.new(pos.X - drawings.Box.Size.X / 2, pos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = color
                        drawings.Box.Visible = true
                    elseif drawings.Box then drawings.Box.Visible = false end

                    if State.espTracers then
                        if not drawings.Tracer then
                            drawings.Tracer = Drawing.new("Line")
                            drawings.Tracer.Thickness = 1
                        end
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(pos.X, pos.Y)
                        drawings.Tracer.Color = color
                        drawings.Tracer.Visible = true
                    elseif drawings.Tracer then drawings.Tracer.Visible = false end

                    if State.espNametags then
                        if not drawings.Name then
                            drawings.Name = Drawing.new("Text")
                            drawings.Name.Size = 13
                            drawings.Name.Center = true
                            drawings.Name.Outline = true
                        end
                        drawings.Name.Text = plr.Name .. " (" .. role .. ")"
                        drawings.Name.Position = Vector2.new(pos.X, pos.Y - 30)
                        drawings.Name.Color = color
                        drawings.Name.Visible = true
                    elseif drawings.Name then drawings.Name.Visible = false end
                else
                    if ESP_drawings[plr] then
                        for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                    end
                end
            else
                if HighlightObjects[plr] then HighlightObjects[plr].Enabled = false end
                if ESP_drawings[plr] then
                    for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                end
            end
        end
    else
        for plr, hl in pairs(HighlightObjects) do if hl then hl.Enabled = false end end
        for plr, drawings in pairs(ESP_drawings) do
            for _, d in pairs(drawings) do d.Visible = false end
        end
    end

    if State.aimbotEnabled and State.aimbotHolding then
        local target = nil
        local shortestDist = math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                if GetRole(plr) == "Murderer" then
                    local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if dist < shortestDist then shortestDist = dist; target = plr.Character.Head end
                    end
                end
            end
        end
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    if State.hitboxExpander > 0 then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                if GetRole(plr) == "Murderer" then
                    plr.Character.HumanoidRootPart.Size = Vector3.new(State.hitboxExpander, State.hitboxExpander, State.hitboxExpander)
                    plr.Character.HumanoidRootPart.Transparency = 0.5
                    plr.Character.HumanoidRootPart.CanCollide = false
                end
            end
        end
    end

    if State.coinFarm then
        for _, v in pairs(Workspace:GetChildren()) do
            if v.Name == "CoinContainer" or v.Name == "Coins" then
                for _, coin in pairs(v:GetChildren()) do
                    if coin:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        if (coin.Position - hrp.Position).Magnitude < 15 then
                            firetouchinterest(hrp, coin, 0)
                            firetouchinterest(hrp, coin, 1)
                        end
                    end
                end
            end
        end
    end

    if State.gunGrabber then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and GetRole(plr) == "Sheriff" and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                end
            end
        end
    end

    if State.antiFlingEnabled then
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                if hrp.Velocity.Magnitude > 250 or hrp.RotVelocity.Magnitude > 250 then
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == State.aimbotKeyBind then
        State.aimbotHolding = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == State.aimbotKeyBind then
        State.aimbotHolding = false
    end
end)

RunService.Stepped:Connect(function()
    if State.noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide=false end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if State.infJump and LocalPlayer.Character then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

RunService.RenderStepped:Connect(function()
    if State.fly and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if not hrp:FindFirstChild("FlyBV") then
            local BV = Instance.new("BodyVelocity", hrp)
            BV.Name = "FlyBV"
            BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            BV.Velocity = Vector3.new(0, 0, 0)
        end
        local moveVec = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVec = moveVec + Vector3.new(0, 50, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVec = moveVec - Vector3.new(0, 50, 0) end
        hrp.FlyBV.Velocity = moveVec
    else
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("FlyBV") then hrp.FlyBV:Destroy() end
    end
end)

