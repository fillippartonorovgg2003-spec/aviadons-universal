local function GetMurderer()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and GetRole(plr)=="murderer" and plr.Character then
            return plr
        end
    end
    return nil
end

local function GetClosestEnemy()
    local target=nil; local shortest=MM2State.aimbotFOV
    local mousePos=UserInputService:GetMouseLocation()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and plr.Character then
            local role=GetRole(plr)
            if role=="murderer" then
                local head=plr.Character:FindFirstChild("Head")
                if head then
                    local pos,onScreen=Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist=(Vector2.new(pos.X,pos.Y)-Vector2.new(mousePos.X,mousePos.Y)).Magnitude
                        if dist<shortest then shortest=dist; target=head end
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if MM2State.aimbotEnabled and MM2State.aimbotHolding then
        local target=GetClosestEnemy()
        if target then
            local currentCF=Camera.CFrame
            local targetCF=CFrame.new(currentCF.Position,target.Position)
            Camera.CFrame=currentCF:Lerp(targetCF,MM2State.aimbotSmooth)
        end
    end
end)

