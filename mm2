local function GetRole(plr)
    if not plr or not plr.Character then return "innocent" end
    local char = plr.Character
    -- проверяем нож (murderer)
    if char:FindFirstChild("Knife") or char:FindFirstChild("KnifeModel") then
        return "murderer"
    end
    -- проверяем пистолет (sheriff)
    if char:FindFirstChild("Sheriff_Gun") or char:FindFirstChild("Gun") then
        return "sheriff"
    end
    -- через leaderstats если есть
    local stats = plr:FindFirstChild("leaderstats") or plr:FindFirstChild("GameStats")
    if stats then
        if stats:FindFirstChild("Role") then
            local role = stats.Role.Value
            if role == "Murderer" then return "murderer" end
            if role == "Sheriff" then return "sheriff" end
        end
    end
    return "innocent"
end

local function GetRoleColor(role)
    if role == "murderer" then return MM2State.murdererColor
    elseif role == "sheriff" then return MM2State.sheriffColor
    else return MM2State.innocentColor end
end

