-- обновление esp (работоспособность)
local function UpdateESP()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local role = GetRole(plr)
            local roleColor = GetRoleColor(role)

            -- убираем все старые
            for _,obj in pairs({"MM2HL","MM2Chams"}) do
                local found = char:FindFirstChild(obj)
                if found then found:Destroy() end
            end

            local shouldShow = MM2State.espEnabled and (
                (role=="murderer" and MM2State.espMurderer) or
                (role=="sheriff" and MM2State.espSheriff) or
