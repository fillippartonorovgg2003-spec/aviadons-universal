                if onScreen then
                    if not ESP_drawings[plr] then ESP_drawings[plr] = {} end
                    local drawings = ESP_drawings[plr]
                    
                    if State.espBoxes then
                        if not drawings.Box then 
                            drawings.Box = Drawing.new("Square")
                            drawings.Box.Thickness = 1
                            drawings.Box.Filled = false
                        end
                        local headPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        drawings.Box.Size = Vector2.new(math.abs(headPos.X - legPos.X) / 2, math.abs(headPos.Y - legPos.Y))
                        drawings.Box.Position = Vector2.new(pos.X - drawings.Box.Size.X / 2, pos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = State.espBoxColor
                        drawings.Box.Visible = true
                    elseif drawings.Box then drawings.Box.Visible = false end

                    if State.espTracers then
                        if not drawings.Tracer then
                            drawings.Tracer = Drawing.new("Line")
                            drawings.Tracer.Thickness = 1
                        end
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(pos.X, pos.Y)
                        drawings.Tracer.Color = State.espTracerColor
                        drawings.Tracer.Visible = true
                    elseif drawings.Tracer then drawings.Tracer.Visible = false end

                    if State.espNametags then
                        if not drawings.Name then
                            drawings.Name = Drawing.new("Text")
                            drawings.Name.Size = 13
                            drawings.Name.Center = true
                            drawings.Name.Outline = true
                        end
                        drawings.Name.Text = plr.Name
                        drawings.Name.Position = Vector2.new(pos.X, pos.Y - 30)
                        drawings.Name.Color = State.espOutlineColor
                        drawings.Name.Visible = true
                    elseif drawings.Name then drawings.Name.Visible = false end
                else
                    if ESP_drawings[plr] then
                        for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                    end
                end
            else
                if HighlightObjects[plr] then HighlightObjects[plr].Enabled = false end
                if ESP_drawings[plr] then
                    for _, d in pairs(ESP_drawings[plr]) do d.Visible = false end
                end
            end
        end
    else
        for plr, hl in pairs(HighlightObjects) do if hl then hl.Enabled = false end end
        for plr, drawings in pairs(ESP_drawings) do
            for _, d in pairs(drawings) do d.Visible = false end
        end
    end

    if State.aimbotEnabled and State.aimbotHolding then
        local target = nil
        local shortestDist = State.aimbotFOV
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(State.aimbotTargetPart) then
                local pos, onScreen = Camera:WorldToViewportPoint(plr.Character[State.aimbotTargetPart].Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        target = plr.Character[State.aimbotTargetPart]
                    end
                end
            end
        end
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 0.2)
        end
    end

    if State.aimLockEnabled and State.aimLockTarget then
        local tp = Players:FindFirstChild(State.aimLockTarget)
        if tp and tp.Character and tp.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, tp.Character.Head.Position)
        end
    end

    if State.hitboxExpander > 0 then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(State.aimbotTargetPart) then
                plr.Character[State.aimbotTargetPart].Size = Vector3.new(State.hitboxExpander, State.hitboxExpander, State.hitboxExpander)
                plr.Character[State.aimbotTargetPart].Transparency = 0.5
                plr.Character[State.aimbotTargetPart].CanCollide = false
            end
        end
    end

    if State.antiFlingEnabled then
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                if hrp.Velocity.Magnitude > 250 or hrp.RotVelocity.Magnitude > 250 then
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end

    if State.cframeSpeed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * State.cframeSpeedVal end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then hrp.CFrame = hrp.CFrame - hrp.CFrame.LookVector * State.cframeSpeedVal end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then hrp.CFrame = hrp.CFrame - hrp.CFrame.RightVector * State.cframeSpeedVal end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then hrp.CFrame = hrp.CFrame + hrp.CFrame.RightVector * State.cframeSpeedVal end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        if State.shiftSprint and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            hum.WalkSpeed = State.sprintVal
        else
            hum.WalkSpeed = State.speed
        end
    end

    if State.fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1e9
        Lighting.GlobalShadows = false
    end

    Camera.FieldOfView = State.fov
end)

task.spawn(function()
    while task.wait(0.1) do
        if State.flingEnabled then
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local myHrp = LocalPlayer.Character.HumanoidRootPart
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                            local targetHrp = plr.Character.HumanoidRootPart
                            if (myHrp.Position - targetHrp.Position).Magnitude < 10 then
                                local oldPos = myHrp.CFrame
                                myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, -3)
                                task.wait(0.02)
                                local bv = Instance.new("BodyAngularVelocity")
                                bv.AngularVelocity = Vector3.new(1, 1, 1) * State.flingPower
                                bv.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                                bv.Parent = myHrp
                                myHrp.CFrame = oldPos
                                task.wait(0.05)
                                bv:Destroy()
                            end
                        end
                    end
                end
            end)
        end
    end
end)

